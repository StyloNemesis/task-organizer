{
  "name": "task-organizer",
  "productName": "Task Organizer",
  "version": "1.2.0",
  "description": "Aplicación de escritorio para organización personal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:linux:all": "electron-builder --linux AppImage deb rpm",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:mac:linux": "electron-builder --mac zip",
    "build:all": "electron-builder -mwl"
  },
  "keywords": [
    "electron",
    "task",
    "organizer",
    "productivity"
  ],
  "author": {
    "name": "aulloa",
    "email": "aulloa@example.com"
  },
  "homepage": "https://github.com/aulloa/task-organizer",
  "license": "MIT",
  "build": {
    "appId": "com.taskorganizer.app",
    "productName": "Task Organizer",
    "directories": {
      "output": "installers"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "assets/icons/icon.png",
      "synopsis": "Aplicación de escritorio para organización personal",
      "description": "Task Organizer es una aplicación completa para gestión de proyectos, tareas y notas con soporte Markdown y organización jerárquica."
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2"
  }
}
